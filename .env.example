# ──────────────────────────────────────────────────────────────────────────────
# DocuEase AI — environment template. Copy to .env and fill in values.
# Never commit a real .env. Everything below has a free option.
# ──────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# MongoDB — free options:
#   • MongoDB Atlas free M0 cluster: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/docuease
#   • Local MongoDB Community Server: mongodb://127.0.0.1:27017/docuease
MONGODB_URI=mongodb://127.0.0.1:27017/docuease

# Sessions (change JWT_SECRET to a long random string: `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=docuease_session
# COOKIE_SECURE=true          # set when serving over HTTPS

# Uploads & processing
STORAGE_DIR=./storage
TMP_DIR=./storage/tmp
MAX_FILE_SIZE_MB=25
MAX_PAGE_COUNT=300
MAX_IMAGE_DIMENSION=6000
MAX_FILES_PER_UPLOAD=10
TRASH_RETENTION_DAYS=30
PROCESSING_CONCURRENCY=2
PROCESSING_TIMEOUT_MS=900000

# OCR (Tesseract.js, runs locally, free). Run `npm run setup:ocr` in server/ once.
OCR_LANGUAGES=eng
OCR_LANG_PATH=./tessdata
OCR_CONCURRENCY=1
OCR_PAGE_TIMEOUT_MS=90000
OCR_MIN_TEXT_CHARS_PER_PAGE=40

# ── AI provider (FREE tiers only) ───────────────────────────────────────────
# Pick ONE provider. All use an OpenAI-compatible chat endpoint.
#   groq        key: https://console.groq.com/keys          default model: openai/gpt-oss-120b
#   gemini      key: https://aistudio.google.com/apikey      default model: gemini-3.5-flash-lite
#   openrouter  key: https://openrouter.ai/keys              default model: openrouter/free
#   mistral     key: https://console.mistral.ai/api-keys     default model: mistral-small-latest
#   cerebras    key: https://cloud.cerebras.ai               default model: llama-3.3-70b
#   github      key: GitHub personal access token            default model: openai/gpt-4o-mini
#   ollama      no key — local, offline: install Ollama, `ollama pull llama3.2`
#   mock        tests only (deterministic placeholder output, never real AI)
AI_PROVIDER=groq
AI_API_KEY=
# AI_MODEL=                   # override the preset's default model
# AI_BASE_URL=                # override the preset's endpoint (required for AI_PROVIDER=custom)
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=24000
AI_MAX_RETRIES=2
AI_USER_REQUESTS_PER_HOUR=60
AI_TRANSLATION_LANGUAGES=English,Hindi,Spanish,French,German,Portuguese,Arabic,Chinese (Simplified),Japanese,Bengali,Tamil

# Email (optional). When EMAIL_PROVIDER=none, password-reset links are shown in the UI in development.
EMAIL_PROVIDER=none
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="DocuEase AI <no-reply@example.com>"

LOG_LEVEL=info
# RATE_LIMIT_DISABLED=true    # local load testing only

# Frontend (client/.env) — see client/.env.example
# VITE_API_URL=http://localhost:4000
