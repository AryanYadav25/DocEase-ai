{
  "name": "docuease-server",
  "version": "1.0.0",
  "private": true,
  "description": "DocuEase AI backend (Express + MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/scripts/seed.ts",
    "setup:ocr": "tsx src/scripts/setup-ocr.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^22.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.8.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "argon2@0.41.1": true,
    "mongodb-memory-server@10.4.3": true,
    "tesseract.js@5.1.1": true
  }
}
